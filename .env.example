# Local AI backend settings. Copy to `.env` (never committed) and edit ON THIS COMPUTER.
# Never paste the key into chat, tickets, screenshots or a VITE_* variable: VITE_ variables are
# bundled into the browser code. The key is read only by the Node server (server/config.ts).

# FASHN API key (https://app.fashn.ai → API). Leave empty until you have one; 2D/3D keep working.
FASHN_API_KEY=

# Let visitors enter their own FASHN API key in the AI panel. It is saved in their browser, sent only
# with their own AI requests, and pays for their previews (no access code, not counted in the daily
# cap). With it on, FASHN_API_KEY is optional. Set false on a shared kiosk, where a key typed by one
# customer would stay in the browser for the next.
AI_USER_KEYS=true

# fashn = real paid cloud provider. fake = offline test provider (development/tests only;
# its results are stamped "TEST RESULT" and are not AI).
AI_PROVIDER=fashn

# Master switch for AI mode. false turns it off completely (the provider is never called). When on,
# your key is spent only if FASHN_API_KEY is set; otherwise visitors use their own (AI_USER_KEYS).
AI_ENABLED=true

# Default preset: max-fast-1k (Try-On Max, fast, 1K, 1 output ≈ 1 credit).
AI_PRESET=max-fast-1k
# Optional comparison presets selectable in Diagnostics, comma-separated: v16-performance
AI_EXTRA_PRESETS=

# Backend address. Keep 127.0.0.1: AI refuses to run on a network-reachable address without
# access control (AI_ALLOW_NON_LOOPBACK=true only after adding authentication + HTTPS).
AI_HOST=127.0.0.1
AI_PORT=3001

# Spending and privacy bounds (enforced server-side).
AI_MAX_CONCURRENT_JOBS=1
# Daily credit cap (UTC day), stored durably in AI_LEDGER_PATH (no images).
AI_MAX_DAILY_CREDITS=20
AI_LEDGER_PATH=.ai-usage/ledger.json
# Local result lifetime after completion, and the overall per-job deadline.
AI_RESULT_TTL_SECONDS=120
AI_JOB_DEADLINE_SECONDS=120
# Kiosk idle timeout: a session and its images are purged after this long without activity.
AI_SESSION_IDLE_SECONDS=600

# Extra page origins allowed to call /api/ai (comma-separated), e.g. a custom dev port.
AI_ALLOWED_ORIGINS=
# Developer uploads (person photo instead of camera, garment photo). Default: on in development,
# off in production.
# AI_DEV_UPLOADS=true

# Optional access code for paid generations (at least 8 characters). REQUIRED on Vercel, where the
# site is public; on the kiosk it can stay empty. Visitors enter it once in the AI panel.
AI_ACCESS_CODE=
# How long a browser stays unlocked after entering the code.
# AI_ACCESS_HOURS=12

# Where sessions, jobs and results live: "memory" (this process; the kiosk default) or "redis"
# (shared Upstash Redis; always used on Vercel). Credentials come from the Vercel Marketplace
# integration (KV_REST_API_URL / KV_REST_API_TOKEN) or an upstash.com database:
# AI_STORE=memory
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
